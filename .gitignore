# Extractos OSM crudos/intermedios (pesados, regenerables con codigo/*.py)
codigo/data/*.pbf
codigo/data/*.osm.xml

# Capas geoespaciales muy pesadas (regenerables, no hacen falta en el repo)
codigo/evidencia/datos/regiones_chile.geojson
codigo/evidencia/datos/aristas_valparaiso.gpkg
codigo/evidencia/datos/nodos_valparaiso.gpkg
codigo/evidencia/datos/conaf_probabilidad_ignicion.geojson
codigo/evidencia/datos/ine_manzanas_gran_valparaiso.geojson

# Python
__pycache__/
*.pyc

# Cache interna de osmnx (respuestas HTTP, no es contenido del proyecto)
codigo/cache/

# Config local de la herramienta (no es del proyecto)
.claude/
